<Window x:Class="SimpleCalculatorMVVM.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе Smart Calculator" 
        Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource MenuForeground}">

    <Window.Resources>
        <!-- Стиль для кнопок в диалоге -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource OperatorButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource OperatorButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OperatorButtonHoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MenuForeground}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Логотип -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                Width="80" Height="80" CornerRadius="40"
                Background="{DynamicResource OperatorButtonBackground}" 
                Margin="0,0,20,0">
            <TextBlock Text="SC" FontSize="28" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Название -->
        <TextBlock Grid.Row="0" Grid.Column="1" 
                   x:Name="TitleText"
                   Text="Smart Calculator MVVM" 
                   FontSize="22" FontWeight="Bold" 
                   Foreground="{DynamicResource OperatorButtonBackground}"
                   Margin="0,10,0,0"/>

        <!-- Версия -->
        <TextBlock Grid.Row="1" Grid.Column="1" 
                   x:Name="VersionText"
                   Text="Версия 2.0.0" 
                   FontSize="14" 
                   Style="{StaticResource DialogTextStyle}"
                   Margin="0,5,0,0"/>

        <!-- Описание -->
        <TextBlock Grid.Row="2" Grid.Column="1" 
                   Text="Профессиональный калькулятор с архитектурой MVVM
Поддерживает Undo/Redo, операции с памятью, научные функции
Построен на WPF и .NET" 
                   FontSize="12" 
                   Style="{StaticResource DialogTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

        <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,15" 
                   Background="{DynamicResource StatusBarForeground}"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="BtnOK" 
                    Content="OK" 
                    Width="80" Height="30" 
                    Style="{StaticResource DialogButtonStyle}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>