<Window x:Class="SimpleCalculatorMVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimpleCalculatorMVVM.ViewModels"
        Title="Smart Calculator MVVM"
        Height="800" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{StaticResource MainFont}"
        Style="{StaticResource WindowStyle}">

    <Window.DataContext>
        <vm:CalculatorViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding EqualsCommand}"/>
    </Window.InputBindings>

    <Grid Margin="0,0,0,-16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Style="{StaticResource MenuStyle}">
            <MenuItem Header="Файл" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Стандартный режим" Style="{StaticResource SubMenuItemStyle}" Command="{Binding SwitchToStandardCommand}"/>
                <MenuItem Header="Научный режим" Style="{StaticResource SubMenuItemStyle}" Command="{Binding SwitchToScientificCommand}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="Выход" Style="{StaticResource SubMenuItemStyle}" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="Вид" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Тёмная тема" Style="{StaticResource SubMenuItemStyle}" Command="{Binding SetDarkThemeCommand}"/>
                <MenuItem Header="Светлая тема" Style="{StaticResource SubMenuItemStyle}" Command="{Binding SetLightThemeCommand}"/>
            </MenuItem>

            <MenuItem Header="Справка" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="О программе" Style="{StaticResource SubMenuItemStyle}" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Style="{StaticResource ToolBarStyle}" Margin="0,5,0,5">
            <Button Command="{Binding UndoCommand}" ToolTip="Отменить (Ctrl+Z)" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="↩" FontSize="20"/>
            </Button>
            <Button Command="{Binding RedoCommand}" ToolTip="Повторить (Ctrl+Y)" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="↪" FontSize="20"/>
            </Button>
            <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>
            <Button Command="{Binding SwitchToStandardCommand}" ToolTip="Стандартный режим" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="Std" FontSize="14" FontWeight="Bold"/>
            </Button>
            <Button Command="{Binding SwitchToScientificCommand}" ToolTip="Научный режим" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="Sci" FontSize="14" FontWeight="Bold"/>
            </Button>
            <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>
            <Button Command="{Binding SetDarkThemeCommand}" ToolTip="Тёмная тема" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="🌙" FontSize="16"/>
            </Button>
            <Button Command="{Binding SetLightThemeCommand}" ToolTip="Светлая тема" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="☀️" FontSize="16"/>
            </Button>
            <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>
            <Button Command="{Binding ToggleSoundCommand}" ToolTip="Вкл/Выкл звук" Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="{Binding SoundIcon}" FontSize="18"/>
            </Button>
        </ToolBar>

        <!-- Основной контент -->
        <Grid Grid.Row="2" Margin="15,15,15,15" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Дисплей -->
            <Border Grid.Row="0"
                    Background="{DynamicResource DisplayBackground}"
                    CornerRadius="8"
                    Margin="0,0,0,15"
                    BorderBrush="{DynamicResource DisplayBorderBrush}"
                    BorderThickness="2">
                <TextBox x:Name="DisplayTextBox"
                         Text="{Binding Display, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="42"
                         FontFamily="{StaticResource DigitalFont}"
                         Foreground="{DynamicResource DisplayForeground}"
                         TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         Padding="15"
                         IsReadOnly="True"/>
            </Border>

            <!-- Статусная строка -->
            <StatusBar Grid.Row="1" Style="{StaticResource StatusBarStyle}" Height="25" Margin="0,0,0,10">
                <Separator/>
                <Separator/>
                <StatusBarItem>
                    <TextBlock Text="Режим: "/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding CurrentMode}" Foreground="#FF8C00" FontWeight="Bold"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock Text="Тема: "/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding CurrentTheme}" Foreground="#FF8C00" FontWeight="Bold"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock Text="Звук: "/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding SoundIcon}" Foreground="#FF8C00" FontWeight="Bold"/>
                </StatusBarItem>
            </StatusBar>

            <!-- Сетка для кнопок — без фиксированных размеров, строки/колонки создаются в коде -->
            <Grid x:Name="ButtonsGrid"
                  Grid.Row="2"
                  Margin="0,0,10,0"
                  VerticalAlignment="Top">
                <!-- Row/Column definitions будут созданы динамически в CreateButtons() -->
            </Grid>

        </Grid>
    </Grid>
</Window>
