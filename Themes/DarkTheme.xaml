<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ========== ТЁМНАЯ ТЕМА ========== -->

	<SolidColorBrush x:Key="WindowBackground" Color="#1A1A1A"/>

	<!-- Верхнее меню -->
	<SolidColorBrush x:Key="MenuBackground" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="MenuForeground" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="MenuHighlightBackground" Color="#FF8C00"/>

	<!-- Выпадающее меню (светлый фон, чёрный текст) -->
	<SolidColorBrush x:Key="SubMenuBackground" Color="#F0F0F0"/>
	<SolidColorBrush x:Key="SubMenuForeground" Color="#000000"/>

	<SolidColorBrush x:Key="ToolBarBackground" Color="#2D2D2D"/>

	<SolidColorBrush x:Key="StatusBarBackground" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="StatusBarForeground" Color="#AAAAAA"/>

	<SolidColorBrush x:Key="DisplayBackground" Color="#1E1E1E"/>
	<SolidColorBrush x:Key="DisplayForeground" Color="#00FF00"/>
	<SolidColorBrush x:Key="DisplayBorderBrush" Color="#FF8C00"/>

	<SolidColorBrush x:Key="NumberButtonBackground" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="NumberButtonForeground" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="NumberButtonHoverBackground" Color="#3D3D3D"/>

	<SolidColorBrush x:Key="OperatorButtonBackground" Color="#FF8C00"/>
	<SolidColorBrush x:Key="OperatorButtonForeground" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="OperatorButtonHoverBackground" Color="#E07B00"/>

	<SolidColorBrush x:Key="ActionButtonBackground" Color="#3D3D3D"/>
	<SolidColorBrush x:Key="ActionButtonForeground" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="ActionButtonHoverBackground" Color="#4D4D4D"/>

	<SolidColorBrush x:Key="ScientificButtonBackground" Color="#3A6EA5"/>
	<SolidColorBrush x:Key="ScientificButtonForeground" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="ScientificButtonHoverBackground" Color="#4A7EB5"/>

	<SolidColorBrush x:Key="MemoryButtonBackground" Color="#4A4A4A"/>
	<SolidColorBrush x:Key="MemoryButtonForeground" Color="#FFFFFF"/>

	<SolidColorBrush x:Key="EqualsButtonBackground" Color="#FF8C00"/>
	<SolidColorBrush x:Key="EqualsButtonForeground" Color="#FFFFFF"/>

</ResourceDictionary>